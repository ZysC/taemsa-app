{
  "expo": {
    "name": "TAEMSA",
    "slug": "mobile",
    "scheme": "taemsa",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#1B6FE8",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TAEMSA necesita acceso a tus fotos para adjuntarlas a la incidencia.",
          "cameraPermission": "TAEMSA necesita la cámara para adjuntar una foto a la incidencia."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/app-check"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taemsa.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.taemsa.app",
      "versionCode": 14,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "86f94975-25df-4df6-96b8-6596e48e798b"
      }
    },
    "owner": "ruben-taemsa"
  }
}
