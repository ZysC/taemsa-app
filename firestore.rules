rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Solo UIDs presentes en /admins/{uid} (créalos en Firebase Console).
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function activeClient(clientId) {
      return clientId is string
        && clientId.size() > 0
        && clientId.size() <= 32
        && exists(/databases/$(database)/documents/clients/$(clientId))
        && get(/databases/$(database)/documents/clients/$(clientId)).data.active == true;
    }

    function validDeviceData() {
      let data = request.resource.data;
      return data.keys().hasAll(['clientId', 'clientName', 'deviceName', 'platform', 'uid'])
        && data.clientId is string
        && data.clientName is string
        && data.clientName.size() > 0
        && data.clientName.size() <= 80
        && data.deviceName is string
        && data.deviceName.size() > 0
        && data.deviceName.size() <= 80
        && data.platform is string
        && data.uid is string
        && data.uid == request.auth.uid
        && activeClient(data.clientId);
    }

    // Lista de administradores: cada user puede leer su doc; escritura solo Console.
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false;
    }

    // Clientes / licencias: el código es el ID del documento.
    // Get con sesión si no existe (para devolver not-found) o si active;
    // list/escritura solo admin (incluye lectura de inactivos).
    match /clients/{clientId} {
      allow list, create, update, delete: if isAdmin();
      allow get: if isAdmin()
        || (isSignedIn() && (resource == null || resource.data.active == true));
    }

    // Avisos: lectura con sesión; escritura solo admin.
    // Los acuses van en subcolección /receipts (no en el documento padre).
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /receipts/{deviceId} {
        // Lectura por uid (compatible con collectionGroup where uid == auth.uid).
        // Escritura: dispositivo existente + cliente activo (no exige mismo uid en devices).
        allow read: if isAdmin()
          || (isSignedIn() && resource.data.uid == request.auth.uid);
        allow create, update: if isAdmin()
          || (isSignedIn()
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.clientName is string
              && request.resource.data.clientName.size() > 0
              && request.resource.data.clientName.size() <= 80
              && exists(/databases/$(database)/documents/devices/$(deviceId))
              && activeClient(
                get(/databases/$(database)/documents/devices/$(deviceId)).data.clientId
              ));
        allow delete: if isAdmin();
      }
    }

    // Actualizaciones Farmatic
    match /farmaticUpdates/{updateId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Información / normativas / guías
    match /infoArticles/{articleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Dispositivos: UUID local; create/update exigen client activo + uid actual.
    // Se permite reclamar el mismo deviceId si el clientId no cambia (reinstalar /
    // nueva sesión anónima en el mismo dispositivo).
    match /devices/{deviceId} {
      allow read, delete: if isAdmin();
      allow create: if isSignedIn() && validDeviceData();
      allow update: if isAdmin()
        || (isSignedIn()
            && validDeviceData()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.clientId == resource.data.clientId);
    }
  }
}
