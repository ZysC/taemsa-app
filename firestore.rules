rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    function onlyUpdatingReceipts() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receipts']);
    }

    function validDeviceWrite() {
      let data = request.resource.data;
      return data.keys().hasAll(['clientName', 'platform'])
        && data.clientName is string
        && data.clientName.size() > 0
        && data.clientName.size() <= 80
        && data.platform is string;
    }

    // Avisos: la app los lee; solo admin crea/borra;
    // la app puede actualizar solo "receipts" (entregada/leída).
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyUpdatingReceipts();
    }

    // Dispositivos: la app registra/actualiza; solo admin lista y borra.
    match /devices/{deviceId} {
      allow read, delete: if isAdmin();
      allow create, update: if validDeviceWrite();
    }
  }
}
